
---
import Base from "@/layouts/Base.astro";
import { getCollectionCTM } from "@/lib/contentParser.astro";
import { supportedLanguages } from "@/lib/utils/i18nUtils.ts";
import config from ".astro/config.generated.json";
import SinglePageLayout from "@/components/SinglePageLayout.astro";
import PageHeader from "@/components/widgets/PageHeader.astro";
import extractSlug from "@/lib/utils/extractSlug";

export async function getStaticPaths() {
  const paths = await Promise.all(
    supportedLanguages.map(async (lang) => {
      const { defaultLanguage, showDefaultLangInUrl } =
        config.settings.multilingual;

      const pages = await getCollectionCTM("pages", lang.languageCode);

      return pages.map((page) => ({
        params: {
          lang:
            !showDefaultLangInUrl && lang.languageCode === defaultLanguage
              ? undefined
              : lang.languageCode,
          page: extractSlug(page).split("/").pop(),
        },
        props: {
          page,
        },
      }));
    }),
  );

  return paths.flat();
}

const { page } = Astro.props;
const isCareersPage = extractSlug(page).split("/").pop() === "careers";
---

<Base {...page.data}>
  {isCareersPage && <PageHeader content={{ title: page.data.title }} />}
  <SinglePageLayout content={{ ...page.data, ...page }} />
</Base>
