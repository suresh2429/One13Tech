
---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils.ts";
import PageHeader from "@/components/widgets/PageHeader.astro";
import ContactSectionTwo from "@/components/sections/ContactSectionTwo.astro";

export function getStaticPaths() {
  return generatePaths();
}
---

<Base
  title="Contact Us"
  metaTitle="Contact One13Tech | Database and IT Solutions"
  metaDescription="Contact One13Tech for database administration, migration, performance optimization, cloud infrastructure, training and staffing services."
>
  <PageHeader content={{ title: "Contact Us" }} />

  <ContactSectionTwo />

  <section class="section-spacing-lg-vertical bg-theme-light">
    <div class="container">
      <div class="mb-10 text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-primary">
          Find Us
        </p>
        <h2 class="text-h2">Our Office Location</h2>
        <p class="mx-auto mt-4 max-w-2xl">
          Visit or contact One13Tech at our Bangalore office.
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-2 lg:items-stretch">
        <div class="overflow-hidden rounded-2xl border bg-white">
          <iframe
            title="One13Tech office location in Bangalore"
            src="https://www.google.com/maps?q=%23314%2C%20Vestaa%20Lushes%2C%20Gopasandra%2C%20Muthanallur%2C%20Bangalore%2C%20Karnataka%2C%20India%20560099&output=embed"
            width="100%"
            height="380"
            style="border: 0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          >
          </iframe>
        </div>

        <div class="flex flex-col justify-center rounded-2xl bg-dark p-8 text-white md:p-12">
          <h3 class="mb-6 text-2xl font-bold">One13Tech</h3>

          <div class="space-y-6">
            <div>
              <p class="mb-2 font-semibold">Office Address</p>
              <p class="leading-7 opacity-80">
                #314, Vestaa Lushes,<br />
                Gopasandra, Muthanallur,<br />
                Bangalore, Karnataka, India - 560099
              </p>
            </div>

            <div>
              <p class="mb-2 font-semibold">Phone</p>
              <a
                href="tel:+919962282429"
                class="opacity-80 transition hover:text-white hover:opacity-100"
              >
                +91 99622 82429
              </a>
            </div>

            <div>
              <p class="mb-2 font-semibold">Email</p>
              <a
                href="mailto:itservices@one13tech.com"
                class="break-all opacity-80 transition hover:text-white hover:opacity-100"
              >
                itservices@one13tech.com
              </a>
            </div>

            <div>
              <p class="mb-2 font-semibold">Business Hours</p>
              <p class="opacity-80">Monday – Saturday</p>
            </div>
          </div>

          <a
            href="https://www.google.com/maps/search/?api=1&query=%23314%2C%20Vestaa%20Lushes%2C%20Gopasandra%2C%20Muthanallur%2C%20Bangalore%2C%20Karnataka%20560099"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 inline-flex w-fit rounded-lg bg-white px-6 py-3 font-semibold text-black transition hover:opacity-80"
          >
            Get Directions
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
